
#!/bin/sh

echo ""
echo "================================"
echo "       PRE-PUSH VALIDATION"
echo "================================"

# Block direct pushes to protected branches
while read local_ref local_sha remote_ref remote_sha
do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master|refs/heads/develop|refs/heads/staging)
      echo ""
      echo "ERROR: Direct push is not allowed to $remote_ref"
      echo "Please create a feature branch and open a Pull Request."
      exit 1
      ;;
  esac
done

# Navigate to Next.js project
cd "$(git rev-parse --show-toplevel)/FE/blog" || exit 1

# Run ESLint
echo ""
echo "1. Running ESLint..."
pnpm lint || exit 1

# Run TypeScript checks
echo ""
echo "2. Checking TypeScript types..."
pnpm type-check || exit 1

# Check Prettier formatting
echo ""
echo "3. Checking code formatting..."
pnpm format:check || exit 1

echo ""
echo "================================"
echo "   ALL CHECKS PASSED!"
echo "   PUSH ALLOWED"
echo "================================"
